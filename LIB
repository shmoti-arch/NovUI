            })

            -- Dropdown panel
            local panel = Util.New("ScrollingFrame", {
                Size              = UDim2.new(1, 0, 0, 0),
                BackgroundColor3  = Theme.BgElevated,
                ScrollBarThickness = 3,
                ScrollBarImageColor3 = Theme.BorderSubtle,
                CanvasSize        = UDim2.new(0, 0, 0, 0),
                Visible           = false,
                ZIndex            = 10,
                Parent            = wrapper,
            })
            Util.Corner(panel, Theme.CornerSm)
            Util.Stroke(panel, Theme.BorderFocus, 1)
            Util.Padding(panel, 4, 4, 4, 4)
            local panelList = Util.ListLayout(panel, Enum.FillDirection.Vertical, 2)

            local function rebuildPanel()
                for _, c in ipairs(panel:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                for _, opt in ipairs(config.Options or {}) do
                    local isSelected = multiSelect and multiSet[opt] or (not multiSelect and opt == selected)
                    local optBtn = Util.New("TextButton", {
                        Size             = UDim2.new(1, 0, 0, 28),
                        BackgroundColor3 = isSelected and Theme.AccentDim or Theme.BgElevated,
                        Text             = "",
                        AutoButtonColor  = false,
                        ZIndex           = 11,
                        Parent           = panel,
                    })
                    Util.Corner(optBtn, Theme.CornerSm)

                    if isSelected then
                        Util.New("TextLabel", {
                            Size             = UDim2.new(0, 12, 0, 12),
                            Position         = UDim2.new(1, -20, 0.5, -6),
                            BackgroundTransparency = 1,
                            Text             = "✓",
                            TextColor3       = Theme.Accent,
                            TextSize         = 11,
                            Font             = Theme.FontBold,
                            ZIndex           = 12,
                            Parent           = optBtn,
                        })
                    end

                    Util.New("TextLabel", {
                        Size             = UDim2.new(1, -28, 1, 0),
                        Position         = UDim2.new(0, 8, 0, 0),
                        BackgroundTransparency = 1,
                        Text             = tostring(opt),
                        TextColor3       = isSelected and Theme.TextPrimary or Theme.TextSecond,
                        TextSize         = 12,
                        Font             = Theme.FontReg,
                        TextXAlignment   = Enum.TextXAlignment.Left,
                        ZIndex           = 12,
                        Parent           = optBtn,
                    })

                    optBtn.MouseEnter:Connect(function()
                        if not (multiSelect and multiSet[opt] or (not multiSelect and opt == selected)) then
                            Util.Tween(optBtn, Theme.TweenFast, { BackgroundColor3 = Theme.BgBase })
                        end
                    end)
                    optBtn.MouseLeave:Connect(function()
                        if not (multiSelect and multiSet[opt] or (not multiSelect and opt == selected)) then
                            Util.Tween(optBtn, Theme.TweenFast, { BackgroundColor3 = Theme.BgElevated })
                        end
                    end)

                    optBtn.MouseButton1Click:Connect(function()
                        if multiSelect then
                            multiSet[opt] = not multiSet[opt]
                            local vals = {}
                            for k, v in pairs(multiSet) do if v then table.insert(vals, k) end end
                            displayLbl.Text = #vals > 0 and table.concat(vals, ", ") or "None"
                            if config.Callback then config.Callback(vals) end
                        else
                            selected = opt
                            displayLbl.Text = tostring(opt)
                            if config.Callback then config.Callback(opt) end
                            -- Close
                            open = false
                            Util.Tween(panel, Theme.TweenFast, { Size = UDim2.new(1, 0, 0, 0) })
                            task.wait(0.15)
                            panel.Visible = false
                            wrapper.Size = UDim2.new(1, 0, 0, 36)
                        end
                        rebuildPanel()
                    end)
                end
                panel.CanvasSize = UDim2.new(0, 0, 0, panelList.AbsoluteContentSize.Y + 8)
            end

            rebuildPanel()

            local function toggleOpen()
                open = not open
                if open then
                    local optCount = math.min(#(config.Options or {}), 5)
                    local panelH   = optCount * 30 + 8
                    panel.Visible = true
                    wrapper.Size  = UDim2.new(1, 0, 0, 36 + panelH + 4)
                    Util.Tween(panel, Theme.TweenMed, { Size = UDim2.new(1, 0, 0, panelH) })
                    Util.Tween(chevron, Theme.TweenFast, { Rotation = 180 })
                else
                    Util.Tween(panel, Theme.TweenFast, { Size = UDim2.new(1, 0, 0, 0) })
                    Util.Tween(chevron, Theme.TweenFast, { Rotation = 0 })
                    task.delay(0.15, function()
                        if not open then
                            panel.Visible = false
                            wrapper.Size  = UDim2.new(1, 0, 0, 36)
                        end
                    end)
                end
            end

            local clickBtn = Util.New("TextButton", {
                Size             = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text             = "",
                ZIndex           = 7,
                Parent           = row,
            })
            clickBtn.MouseButton1Click:Connect(toggleOpen)
            Util.HoverPulse(row, rowStroke)

            return {
                Set     = function(_, v) selected = v; displayLbl.Text = tostring(v); rebuildPanel() end,
                Get     = function() return multiSelect and multiSet or selected end,
                Refresh = function(_, opts) config.Options = opts; rebuildPanel() end,
            }
        end

