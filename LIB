    Window._tabs       = {}
    Window._activeTab  = nil
    Window._gui        = gui
    Window._root       = root

    function Window:AddTab(name, icon)
        local Tab = {}
        Tab._name       = name
        Tab._sections   = {}
        Tab._components = {}

        -- Tab button in sidebar
        local tabBtn = Util.New("TextButton", {
            Size             = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = Theme.BgBase,
            BackgroundTransparency = 1,
            Text             = "",
            AutoButtonColor  = false,
            Parent           = tabButtonContainer,
        })
        Util.Corner(tabBtn, Theme.CornerSm)

        -- Active indicator bar
        local activeBar = Util.New("Frame", {
            Size             = UDim2.new(0, 3, 0.6, 0),
            Position         = UDim2.new(0, 0, 0.2, 0),
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 1,
            Parent           = tabBtn,
        })
        Util.Corner(activeBar, Theme.CornerFull)

        -- Icon (if provided)
        if icon then
            Util.New("ImageLabel", {
                Size             = UDim2.new(0, 16, 0, 16),
                Position         = UDim2.new(0, 10, 0.5, -8),
                BackgroundTransparency = 1,
                Image            = icon,
                ImageColor3      = Theme.TextMuted,
                Parent           = tabBtn,
            })
        end

        Util.New("TextLabel", {
            Size             = UDim2.new(1, icon and -32 or -14, 1, 0),
            Position         = UDim2.new(0, icon and 30 or 10, 0, 0),
            BackgroundTransparency = 1,
            Text             = name,
            TextColor3       = Theme.TextMuted,
            TextSize         = 12,
            Font             = Theme.FontSemi,
            TextXAlignment   = Enum.TextXAlignment.Left,
            Name             = "Label",
            Parent           = tabBtn,
        })

        -- Tab content page (scrolling)
        local page = Util.New("ScrollingFrame", {
            Name              = "Page_" .. name,
            Size              = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.BorderSubtle,
            CanvasSize        = UDim2.new(0, 0, 0, 0),
            Visible           = false,
            Parent            = contentArea,
        })
        Util.Padding(page, 10, 10, 10, 10)
        local pageList = Util.ListLayout(page, Enum.FillDirection.Vertical, 6)
        Util.AutoCanvas(page, pageList)

        Tab._page     = page
        Tab._list     = pageList
        Tab._btn      = tabBtn
        Tab._activeBar = activeBar

        -- Activate this tab
        local function activate()
            -- Deactivate previous
            if Window._activeTab and Window._activeTab ~= Tab then
                local prev = Window._activeTab
                prev._page.Visible = false
                Util.Tween(prev._btn,       Theme.TweenFast, { BackgroundTransparency = 1 })
                Util.Tween(prev._activeBar, Theme.TweenFast, { BackgroundTransparency = 1 })
                prev._btn.Label.TextColor3 = Theme.TextMuted
            end
            Window._activeTab = Tab
            page.Visible = true
            Util.Tween(tabBtn,    Theme.TweenFast, { BackgroundTransparency = 0.6 })
            Util.Tween(activeBar, Theme.TweenFast, { BackgroundTransparency = 0 })
            tabBtn.Label.TextColor3 = Theme.TextPrimary
        end

        tabBtn.MouseButton1Click:Connect(activate)
        tabBtn.MouseEnter:Connect(function()
            if Window._activeTab ~= Tab then
                Util.Tween(tabBtn, Theme.TweenFast, { BackgroundTransparency = 0.8 })
            end
        end)
        tabBtn.MouseLeave:Connect(function()
            if Window._activeTab ~= Tab then
                Util.Tween(tabBtn, Theme.TweenFast, { BackgroundTransparency = 1 })
            end
        end)

        -- Auto-activate first tab
        if #Window._tabs == 0 then
            activate()
        end
        table.insert(Window._tabs, Tab)

        --    Component Builders                                
        local currentSection = nil  -- the last section's list, or page itself

        local function getParent()
            return currentSection or page
        end

        -- SECTION                                              
        function Tab:AddSection(name)
            local sec = Util.New("Frame", {
                Name             = "Section_" .. name,
                Size             = UDim2.new(1, 0, 0, 0),
                AutomaticSize    = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Parent           = page,
            })

            -- Section header
            local header = Util.New("Frame", {
                Size             = UDim2.new(1, 0, 0, 24),
                BackgroundTransparency = 1,
                Parent           = sec,
            })

            Util.New("TextLabel", {
                Size             = UDim2.new(0, 0, 1, 0),
                AutomaticSize    = Enum.AutomaticSize.X,
                BackgroundTransparency = 1,
                Text             = string.upper(name),
                TextColor3       = Theme.TextMuted,
                TextSize         = 10,
                Font             = Theme.FontBold,
                TextXAlignment   = Enum.TextXAlignment.Left,
                Parent           = header,
            })

            Util.New("Frame", {
                Size             = UDim2.new(1, 0, 0, 1),
                Position         = UDim2.new(0, 0, 1, -1),
                BackgroundColor3 = Theme.BorderSubtle,
