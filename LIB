            Util.Corner(row, Theme.CornerSm)
            local rowStroke = Util.Stroke(row, Theme.BorderSubtle, 1)

            Util.New("TextLabel", {
                Size             = UDim2.new(1, -70, 1, 0),
                Position         = UDim2.new(0, 12, 0, 0),
                BackgroundTransparency = 1,
                Text             = config.Label or "Color",
                TextColor3       = Theme.TextPrimary,
                TextSize         = 13,
                Font             = Theme.FontSemi,
                TextXAlignment   = Enum.TextXAlignment.Left,
                ZIndex           = 6,
                Parent           = row,
            })

            local preview = Util.New("Frame", {
                Size             = UDim2.new(0, 50, 0, 22),
                Position         = UDim2.new(1, -58, 0.5, -11),
                BackgroundColor3 = color,
                ZIndex           = 6,
                Parent           = row,
            })
            Util.Corner(preview, Theme.CornerSm)
            Util.Stroke(preview, Theme.BorderSubtle, 1)

            -- Picker panel
            local panel = Util.New("Frame", {
                Size             = UDim2.new(1, 0, 0, 0),
                BackgroundColor3 = Theme.BgElevated,
                Visible          = false,
                ZIndex           = 8,
                Parent           = wrapper,
            })
            Util.Corner(panel, Theme.CornerSm)
            Util.Stroke(panel, Theme.BorderFocus, 1)

            -- SV square (saturation/value)
            local svSize = 140
            local svBox = Util.New("ImageLabel", {
                Size             = UDim2.new(0, svSize, 0, svSize),
                Position         = UDim2.new(0, 10, 0, 10),
                Image            = "rbxassetid://6020299385",
                ZIndex           = 9,
                Parent           = panel,
            })
            svBox.BackgroundColor3 = Util.HSVtoRGB(h, 1, 1)
            Util.Corner(svBox, Theme.CornerSm)

            local svThumb = Util.New("Frame", {
                Size             = UDim2.new(0, 12, 0, 12),
                BackgroundColor3 = Theme.White,
                ZIndex           = 10,
                AnchorPoint      = Vector2.new(0.5, 0.5),
                Parent           = svBox,
            })
            Util.Corner(svThumb, Theme.CornerFull)
            Util.Stroke(svThumb, Theme.BgDeep, 1.5)

            -- Hue bar
            local hueBar = Util.New("ImageLabel", {
                Size             = UDim2.new(0, 16, 0, svSize),
                Position         = UDim2.new(0, svSize + 18, 0, 10),
                Image            = "rbxassetid://6020299385",
                ZIndex           = 9,
                Parent           = panel,
            })
            hueBar.BackgroundColor3 = Theme.White

            -- Manual hue gradient using UIGradient
            local hueGrad = Instance.new("UIGradient")
            hueGrad.Rotation = 90
            hueGrad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0,    Color3.fromRGB(255, 0,   0)),
                ColorSequenceKeypoint.new(0.167,Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.333,Color3.fromRGB(0,   255, 0)),
                ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(0,   255, 255)),
                ColorSequenceKeypoint.new(0.667,Color3.fromRGB(0,   0,   255)),
                ColorSequenceKeypoint.new(0.833,Color3.fromRGB(255, 0,   255)),
                ColorSequenceKeypoint.new(1,    Color3.fromRGB(255, 0,   0)),
            })
            hueGrad.Parent = hueBar
            Util.Corner(hueBar, Theme.CornerSm)

            local hueThumb = Util.New("Frame", {
                Size             = UDim2.new(1, 4, 0, 4),
                Position         = UDim2.new(0, -2, 0, 0),
                BackgroundColor3 = Theme.White,
                ZIndex           = 10,
                Parent           = hueBar,
            })
            Util.Corner(hueThumb, Theme.CornerFull)
            Util.Stroke(hueThumb, Theme.BgDeep, 1)

            -- Hex input
            local hexInput = Util.New("TextBox", {
                Size             = UDim2.new(0, svSize, 0, 24),
                Position         = UDim2.new(0, 10, 0, svSize + 18),
                BackgroundColor3 = Theme.BgInput,
                Text             = "",
                TextColor3       = Theme.TextPrimary,
                TextSize         = 11,
                Font             = Theme.FontReg,
                PlaceholderText  = "#RRGGBB",
                PlaceholderColor3 = Theme.TextMuted,
                ZIndex           = 9,
                Parent           = panel,
            })
            Util.Corner(hexInput, Theme.CornerSm)
            Util.Stroke(hexInput, Theme.BorderSubtle, 1)
            Util.Padding(hexInput, 0, 6, 0, 6)

            local function updateFromHSV(nh, ns, nv, silent)
                h, s, v = nh, ns, nv
                color = Color3.fromHSV(h, s, v)
                preview.BackgroundColor3 = color
                svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                -- Update thumbs
                svThumb.Position = UDim2.new(s, 0, 1 - v, 0)
                hueThumb.Position = UDim2.new(0, -2, h, 0)
                -- Hex
                local r = math.floor(color.R * 255)
                local g = math.floor(color.G * 255)
                local b = math.floor(color.B * 255)
                hexInput.Text = string.format("#%02X%02X%02X", r, g, b)
                if not silent and config.Callback then config.Callback(color) end
            end

            updateFromHSV(h, s, v, true)

            -- SV drag
            local svDragging = false
            svBox.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then svDragging = true end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then svDragging = false end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if not svDragging then return end
                if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
                local abs = svBox.AbsolutePosition
                local sz  = svBox.AbsoluteSize
                local ns  = math.clamp((input.Position.X - abs.X) / sz.X, 0, 1)
                local nv  = 1 - math.clamp((input.Position.Y - abs.Y) / sz.Y, 0, 1)
                updateFromHSV(h, ns, nv)
            end)

            -- Hue drag
            local hueDragging = false
            hueBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then hueDragging = true end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then hueDragging = false end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if not hueDragging then return end
                if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
                local abs = hueBar.AbsolutePosition
                local sz  = hueBar.AbsoluteSize
                local nh  = math.clamp((input.Position.Y - abs.Y) / sz.Y, 0, 1)
                updateFromHSV(nh, s, v)
            end)

            -- Hex input
            hexInput.FocusLost:Connect(function()
                local hex = hexInput.Text:gsub("#", "")
                if #hex == 6 then
                    local r = tonumber(hex:sub(1,2), 16)
                    local g = tonumber(hex:sub(3,4), 16)
                    local b = tonumber(hex:sub(5,6), 16)
                    if r and g and b then
                        local nc = Color3.fromRGB(r, g, b)
                        local nh, ns, nv = Color3.toHSV(nc)
                        updateFromHSV(nh, ns, nv)
                    end
                end
            end)

            local panelH = svSize + 52
            local clickBtn = Util.New("TextButton", {
                Size             = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text             = "",
                ZIndex           = 7,
                Parent           = row,
            })
            clickBtn.MouseButton1Click:Connect(function()
                open = not open
                if open then
                    panel.Visible = true
                    wrapper.Size  = UDim2.new(1, 0, 0, 36 + panelH + 4)
                    Util.Tween(panel, Theme.TweenMed, { Size = UDim2.new(1, 0, 0, panelH) })
                else
                    Util.Tween(panel, Theme.TweenFast, { Size = UDim2.new(1, 0, 0, 0) })
                    task.delay(0.15, function()
                        if not open then
                            panel.Visible = false
                            wrapper.Size  = UDim2.new(1, 0, 0, 36)
                        end
                    end)
                end
            end)
            Util.HoverPulse(row, rowStroke)

            return {
                Set = function(_, c)
                    local nh, ns, nv = Color3.toHSV(c)
                    updateFromHSV(nh, ns, nv, true)
                end,
                Get = function() return color end,
            }
        end

        return Tab
    end -- AddTab

    return Window
end -- CreateWindow

return NovUI
