local function Notify(config)
    -- config: Title, Message, Type ("info"|"success"|"warning"|"danger"), Duration
    local iconColor = ({
        info    = Theme.Accent,
        success = Theme.Success,
        warning = Theme.Warning,
        danger  = Theme.Danger,
    })[config.Type or "info"] or Theme.Accent

    local card = Util.New("Frame", {
        Name              = "Notif",
        Size              = UDim2.new(1, 0, 0, 70),
        BackgroundColor3  = Theme.BgElevated,
        BackgroundTransparency = 1,
        ClipsDescendants  = true,
        LayoutOrder       = -tick(),
        Parent            = NotifContainer,
    })
    Util.Corner(card, Theme.CornerMd)
    local cardStroke = Util.Stroke(card, iconColor, 1, 0.5)

    -- Accent bar on left
    Util.New("Frame", {
        Size             = UDim2.new(0, 3, 1, -12),
        Position         = UDim2.new(0, 6, 0, 6),
        BackgroundColor3 = iconColor,
        Parent           = card,
    }, { Instance.new("UICorner") })

    -- Title
    Util.New("TextLabel", {
        Size             = UDim2.new(1, -22, 0, 18),
        Position         = UDim2.new(0, 18, 0, 10),
        BackgroundTransparency = 1,
        Text             = config.Title or "Notice",
        TextColor3       = Theme.TextPrimary,
        TextSize         = 13,
        Font             = Theme.FontSemi,
        TextXAlignment   = Enum.TextXAlignment.Left,
        Parent           = card,
    })

    -- Message
    Util.New("TextLabel", {
        Size             = UDim2.new(1, -22, 0, 28),
        Position         = UDim2.new(0, 18, 0, 30),
        BackgroundTransparency = 1,
        Text             = config.Message or "",
        TextColor3       = Theme.TextSecond,
        TextSize         = 11,
        Font             = Theme.FontReg,
        TextXAlignment   = Enum.TextXAlignment.Left,
        TextWrapped      = true,
        Parent           = card,
    })

    -- Progress bar
    local progBg = Util.New("Frame", {
        Size             = UDim2.new(1, -12, 0, 2),
        Position         = UDim2.new(0, 6, 1, -6),
        BackgroundColor3 = Theme.BgDeep,
        Parent           = card,
    })
    Util.Corner(progBg, Theme.CornerFull)

    local prog = Util.New("Frame", {
        Size             = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = iconColor,
        Parent           = progBg,
    })
    Util.Corner(prog, Theme.CornerFull)

    -- Animate in
    Util.Tween(card, Theme.TweenBounce, { BackgroundTransparency = 0 })

    local duration = config.Duration or 4
    -- Animate progress bar
    Util.Tween(prog, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) })

    -- Dismiss after duration
    task.delay(duration, function()
        Util.Tween(card, Theme.TweenMed, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0) })
        task.wait(0.3)
        card:Destroy()
    end)

    return card
end

