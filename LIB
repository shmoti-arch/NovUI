        -- SLIDER                                               
        function Tab:AddSlider(config)
            -- config: Label, Min, Max, Default, Step, Suffix, Callback
            local min   = config.Min     or 0
            local max   = config.Max     or 100
            local step  = config.Step    or 1
            local value = config.Default or min
            local suf   = config.Suffix  or ""

            local row = Util.New("Frame", {
                Size             = UDim2.new(1, 0, 0, 56),
                BackgroundColor3 = Theme.BgBase,
                Parent           = getParent(),
            })
            Util.Corner(row, Theme.CornerSm)
            local rowStroke = Util.Stroke(row, Theme.BorderSubtle, 1)

            -- Header row with label + value
            local labelLbl = Util.New("TextLabel", {
                Size             = UDim2.new(1, -60, 0, 18),
                Position         = UDim2.new(0, 12, 0, 8),
                BackgroundTransparency = 1,
                Text             = config.Label or "Slider",
                TextColor3       = Theme.TextPrimary,
                TextSize         = 13,
                Font             = Theme.FontSemi,
                TextXAlignment   = Enum.TextXAlignment.Left,
                Parent           = row,
            })

            local valueLbl = Util.New("TextLabel", {
                Size             = UDim2.new(0, 50, 0, 18),
                Position         = UDim2.new(1, -58, 0, 8),
                BackgroundTransparency = 1,
                Text             = tostring(value) .. suf,
                TextColor3       = Theme.Accent,
                TextSize         = 12,
                Font             = Theme.FontSemi,
                TextXAlignment   = Enum.TextXAlignment.Right,
                Parent           = row,
            })

            -- Track
            local track = Util.New("Frame", {
                Size             = UDim2.new(1, -24, 0, 6),
                Position         = UDim2.new(0, 12, 0, 38),
                BackgroundColor3 = Theme.BgInput,
                Parent           = row,
            })
            Util.Corner(track, Theme.CornerFull)
            Util.Stroke(track, Theme.BorderSubtle, 1)

            local fill = Util.New("Frame", {
                Size             = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = Theme.Accent,
                Parent           = track,
            })
            Util.Corner(fill, Theme.CornerFull)

            local thumb = Util.New("Frame", {
                Size             = UDim2.new(0, 14, 0, 14),
                Position         = UDim2.new(0, -7, 0.5, -7),
                BackgroundColor3 = Theme.White,
                ZIndex           = 2,
                Parent           = fill,
            })
            Util.Corner(thumb, Theme.CornerFull)
            Util.Stroke(thumb, Theme.Accent, 1.5)

            local function setValue(v, silent)
                v = math.clamp(math.round((v - min) / step) * step + min, min, max)
                value = v
                local pct = (v - min) / (max - min)
                Util.Tween(fill, Theme.TweenFast, { Size = UDim2.new(pct, 0, 1, 0) })
                valueLbl.Text = tostring(v) .. suf
                if not silent and config.Callback then config.Callback(v) end
            end

            setValue(value, true)

            -- Drag logic
            local dragging = false
            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if not dragging then return end
                if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
                local abs    = track.AbsolutePosition
                local width  = track.AbsoluteSize.X
                local rel    = math.clamp((input.Position.X - abs.X) / width, 0, 1)
                setValue(min + (max - min) * rel)
            end)
            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    local abs   = track.AbsolutePosition
                    local width = track.AbsoluteSize.X
                    local rel   = math.clamp((input.Position.X - abs.X) / width, 0, 1)
                    setValue(min + (max - min) * rel)
                end
            end)

            Util.HoverPulse(row, rowStroke)

            return {
                Set = function(_, v) setValue(v, true) end,
                Get = function() return value end,
            }
        end

